# ─── Frontend (bundled into the client — must be prefixed VITE_) ───────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─── Serverless functions only (api/**) — never prefix these with VITE_ ────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# QuickBooks Online app (developer.intuit.com) — start with Sandbox keys
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=https://financial-dashboard-for-business.vercel.app/api/qbo/callback

# Generate once with: openssl rand -hex 32
QBO_STATE_SECRET=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`
CRON_SECRET=

# AES-256 key encrypting OAuth tokens at rest — generate once with:
# openssl rand -hex 32 (must stay exactly 64 hex characters / 32 bytes)
QBO_TOKEN_ENC_KEY=
